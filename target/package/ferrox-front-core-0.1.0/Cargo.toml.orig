[package]
description = "Reactive Signals engine, Wasm Virtual DOM builder, and runtime Glassmorphism theming for Ferrox Front."
name = "ferrox-front-core"
version = "0.1.0"
edition = "2021"
license = "MIT"
repository = "https://github.com/AI-Autistic-Intelligence/ferrox-front"
homepage = "https://ferrox-front.dev"
documentation = "https://docs.ferrox-front.dev"

[dependencies]
wasm-bindgen = "0.2"

[dependencies.web-sys]
version = "0.3"
features = ["Window", "Document", "Element", "HtmlElement", "Node", "Text", "EventTarget"]

[dev-dependencies]
wasm-bindgen-test = "0.3"

